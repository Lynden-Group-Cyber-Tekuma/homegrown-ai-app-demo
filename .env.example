# ─────────────────────────────────────────────────────────────────────────────
# HomeGrown App Demo - environment variables
#
# Copy to `.env` and fill in the values you need. Every variable is optional
# unless noted; sensible defaults apply when unset. Never commit your `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (set all three before any production-like use) ─────────────────
# Fernet key encrypting secrets at rest (PS App IDs, LLM keys, JWT secret).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: changing this key makes previously encrypted DB values unreadable.
ENCRYPTION_KEY=

# JWT signing secret. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Unset = ephemeral key per process (all sessions invalidated on restart).
SECRET_KEY=

# Bootstrap admin credentials (first run only; change via Admin -> Settings after).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Environment ──────────────────────────────────────────────────────────────
# development | production - production refuses to start with insecure defaults.
APP_ENV=development

# JWT lifetime in hours (default 24).
#TOKEN_TTL_H=24

# ── Database ─────────────────────────────────────────────────────────────────
# Default: Postgres from docker-compose (postgresql+asyncpg://hgapp:hgapp_dev@db:5432/hgapp)
#
# Option A - switch to file-based SQLite (no Postgres needed):
#DB_BACKEND=sqlite
# Optional custom SQLite file location (default: app/data/hgapp.db):
#SQLITE_PATH=/app/data/hgapp.db
#
# Option B - full SQLAlchemy async URL (takes precedence over DB_BACKEND):
#DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
#DATABASE_URL=sqlite+aiosqlite:///./data/hgapp.db

# ── Shared LLM provider keys (can also be set in Admin -> Settings -> LLM Keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# Show per-user LLM key fields in the user settings UI (default false).
#SHOW_LLM_KEY_SETTINGS=false

# ── Usage limits ─────────────────────────────────────────────────────────────
# Per-user daily message cap; 0 = unlimited (default 50).
#DEFAULT_DAILY_LIMIT=50
# Upload size limit in MB (default 10).
#MAX_FILE_SIZE_MB=10
# File-scan rate limits per user (defaults: 5/minute, 1 concurrent).
#SANITIZE_MAX_PER_MINUTE=5
#SANITIZE_MAX_CONCURRENT_PER_USER=1

# ── Email / SMTP (required for Open Mode magic-link sign-in) ─────────────────
# DB values saved in Admin -> Settings -> Email take precedence over these.
SMTP_HOST=
#SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
FROM_EMAIL=
# Public base URL of this app, used in email links (e.g. https://demo.example.com).
APP_BASE_URL=
